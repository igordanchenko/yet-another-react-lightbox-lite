{
  "name": "yet-another-react-lightbox-lite",
  "version": "0.0.0-semantic-release",
  "description": "Lightweight React lightbox component",
  "repository": "github:igordanchenko/yet-another-react-lightbox-lite",
  "homepage": "https://github.com/igordanchenko/yet-another-react-lightbox-lite",
  "bugs": "https://github.com/igordanchenko/yet-another-react-lightbox-lite/issues",
  "funding": "https://github.com/sponsors/igordanchenko",
  "author": "Igor Danchenko",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "build": "npm-run-all clean build:*",
    "start": "npm-run-all clean --parallel \"build:* -- -w\"",
    "build:js": "rollup -c",
    "build:css": "lightningcss-build",
    "lint": "eslint",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "dev": "vite --config dev/vite.config.ts",
    "dev:build": "vite build --config dev/vite.config.ts",
    "dev:preview": "vite preview --config dev/vite.config.ts",
    "size": "size-limit",
    "ci": "npm-run-all build test lint size"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.5",
    "@rollup/plugin-typescript": "12.3.0",
    "@size-limit/preset-small-lib": "13.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "commitlint-pre-push": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lightningcss-build": "1.0.1",
    "lint-staged": "17.2.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "size-limit": "13.0.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "keywords": [
    "react",
    "lightbox",
    "react lightbox",
    "react lightbox lite",
    "lightweight react lightbox"
  ]
}
