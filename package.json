{
  "name": "yet-another-react-lightbox-lite",
  "version": "0.0.0-semantic-release",
  "description": "Lightweight React lightbox component",
  "repository": "github:igordanchenko/yet-another-react-lightbox-lite",
  "homepage": "https://github.com/igordanchenko/yet-another-react-lightbox-lite",
  "bugs": "https://github.com/igordanchenko/yet-another-react-lightbox-lite/issues",
  "funding": "https://github.com/sponsors/igordanchenko",
  "author": "Igor Danchenko",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "build": "npm-run-all clean build:*",
    "start": "npm-run-all clean --parallel \"build:* -- -w\"",
    "build:js": "rollup -c",
    "build:css": "lightningcss-build",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "dev": "vite --config dev/vite.config.ts",
    "dev:build": "vite build --config dev/vite.config.ts",
    "dev:preview": "vite preview --config dev/vite.config.ts",
    "size": "size-limit",
    "ci": "npm-run-all build test lint size"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@rollup/plugin-typescript": "12.3.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "commitlint-pre-push": "1.0.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lightningcss-build": "1.0.2",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "rollup": "4.65.0",
    "rollup-plugin-dts": "6.5.1",
    "size-limit": "14.3.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "react",
    "lightbox",
    "react lightbox",
    "react lightbox lite",
    "lightweight react lightbox"
  ]
}
